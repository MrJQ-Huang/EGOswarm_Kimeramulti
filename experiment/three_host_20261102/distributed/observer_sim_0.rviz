Panels:
- Class: rviz/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/Grid
    Enabled: true
    Name: Reference Grid
    Value: true
    Plane Cell Count: 60
  - Class: rviz/Marker
    Enabled: true
    Name: AMOV native local faces and original colors
    Marker Topic: /observer/sim_0/local_mesh_faces
    Queue Size: 1
    Value: true
  - Class: rviz/Marker
    Enabled: true
    Name: Freshness and last known state
    Marker Topic: /observer/sim_0/freshness
    Queue Size: 1
    Value: true
  - Class: rviz/Odometry
    Enabled: true
    Name: Native VIO body pose
    Topic: /observer/sim_0/vio
    Keep: 1
    Value: true
  Global Options:
    Fixed Frame: sim_0/vio_odom
    Frame Rate: 30
    Background Color: 10; 18; 32
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 70
      Focal Point: {X: 16, Y: 0, Z: 1}
      Pitch: 1.05
      Yaw: -1.57
Window Geometry: {Height: 850, Width: 1100}
