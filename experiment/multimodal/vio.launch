<launch><param name="/use_sim_time" value="false" /><group ns="sim_1"><include file="/opt/kimera_ws/src/kimera_ros/launch/kimera_vio_ros.launch"><arg name="params_folder" value="/experiment/multimodal/params" /><arg name="robot_id" value="1" /><arg name="multirobot" value="true" /><arg name="online" value="true" /><arg name="should_use_sim_time" value="false" /><arg name="left_cam_topic" value="/sim_1/kimera/rgb/image_raw" /><arg name="right_cam_topic" value="" /><arg name="depth_cam_topic" value="/sim_1/kimera/depth/image_raw" /><arg name="imu_topic" value="/sim_1/kimera/imu" /><arg name="use_external_odom" value="false" /><arg name="external_odom_topic" value="" /><arg name="force_same_image_timestamp" value="false" /><arg name="do_coarse_temporal_sync" value="false" /><arg name="do_fine_temporal_sync" value="false" /><arg name="use_lcd" value="true" /><arg name="lcd_no_detection" value="false" /><arg name="lcd_no_optimize" value="true" /><arg name="path_to_vocab" value="$(find kimera_vio)/vocabulary/ORBvoc.yml" /><arg name="publish_vlc_frames" value="true" /><arg name="bow_batch_size" value="1" /><arg name="bow_skip_num" value="1" /><arg name="lcd_disable_stereo_match_depth_check" value="false" /><arg name="no_incremental_pose" value="false" /><arg name="visualize" value="true" /><arg name="viz_type" value="2" /><arg name="use_rviz" value="true" /><arg name="log_output" value="true" /><arg name="log_output_path" value="/experiment/multimodal/vio_logs" /><arg name="verbosity" value="0" /><arg name="odom_frame_id" value="sim_1/vio_odom" /><arg name="base_link_frame_id" value="sim_1/imu" /><arg name="map_frame_id" value="sim_1/map" /><arg name="left_cam_frame_id" value="sim_1/camera_optical" /><arg name="right_cam_frame_id" value="sim_1/camera_optical" /></include></group></launch>