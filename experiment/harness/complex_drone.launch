<launch>
  <arg name="drone_id"/>
  <arg name="init_x"/><arg name="init_y"/><arg name="init_z"/>
  <arg name="target_x"/><arg name="target_y"/><arg name="target_z"/>
  <arg name="map_size_x" default="24.0"/>
  <arg name="map_size_y" default="16.0"/>
  <arg name="map_size_z" default="4.0"/>
  <arg name="max_vel" default="1.0"/>
  <group>
    <!-- The original camera-style CPU renderer stays idle. An independent
         range_sensor.py process supplies ideal omnidirectional local clouds. -->
    <remap from="/map_generator/global_cloud" to="/two_pc/disabled_camera_cloud"/>
    <include file="$(dirname)/one_drone.launch">
      <arg name="drone_id" value="$(arg drone_id)"/>
      <arg name="init_x" value="$(arg init_x)"/><arg name="init_y" value="$(arg init_y)"/><arg name="init_z" value="$(arg init_z)"/>
      <arg name="target_x" value="$(arg target_x)"/><arg name="target_y" value="$(arg target_y)"/><arg name="target_z" value="$(arg target_z)"/>
      <arg name="map_size_x" value="$(arg map_size_x)"/><arg name="map_size_y" value="$(arg map_size_y)"/><arg name="map_size_z" value="$(arg map_size_z)"/>
    </include>
  </group>
  <param name="drone_$(arg drone_id)_ego_planner_node/grid_map/obstacles_inflation" value="0.25"/>
  <param name="drone_$(arg drone_id)_ego_planner_node/manager/max_vel" value="$(arg max_vel)"/>
  <param name="drone_$(arg drone_id)_ego_planner_node/optimization/max_vel" value="$(arg max_vel)"/>
  <param name="drone_$(arg drone_id)_ego_planner_node/bspline/limit_vel" value="$(arg max_vel)"/>
</launch>
